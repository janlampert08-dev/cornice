{
  "name": "cornice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "worker": "ts-node scripts/agent-worker.ts",
    "dashboard": "ts-node scripts/agent-dashboard.ts",
    "redis:start": "docker run -p 6379:6379 -d --name cornice-redis redis:7",
    "redis:stop": "docker stop cornice-redis && docker rm cornice-redis || true"
  },

  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "mapbox-gl": "^3.29.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "bullmq": "^2.11.0",
    "ioredis": "^5.3.2",
    "express": "^4.18.2",
    "@bull-board/api": "^4.6.0",
    "@bull-board/express": "^4.6.0"
  },

  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "ts-node": "^10.9.1"
  }
}
